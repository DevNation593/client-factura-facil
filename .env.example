# Copiar a .env.local (no se versiona) y completar. Ninguna de estas variables llega al navegador.

# Dirección de la API de Spring, sin /api/v1.
API_BASE_URL=http://localhost:8080
# Cuánto se espera a la API antes de darla por caída, en milisegundos (por defecto 30000).
#API_TIMEOUT_MS=30000
# Dirección pública de esta aplicación web (para la redirección del inicio de sesión).
APP_BASE_URL=http://localhost:3000

# Proveedor OIDC. Debe ser el mismo emisor que valida la API (OIDC_ISSUER del backend).
OIDC_ISSUER=http://localhost:8081/realms/einvoice
OIDC_CLIENT_ID=einvoice-web
# Solo si el cliente es confidencial; un cliente público con PKCE no lo necesita.
#OIDC_CLIENT_SECRET=
# Audiencia de la API en el token de acceso, si el proveedor exige pedirla.
#OIDC_AUDIENCE=einvoice-api

# Secreto con el que se cifran las cookies de sesión: al menos 32 caracteres aleatorios.
# Para generarlo: openssl rand -base64 48
SESSION_SECRET=change-me

# Desactiva la telemetría anónima de Next.js.
NEXT_TELEMETRY_DISABLED=1
