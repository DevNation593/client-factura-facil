# Copiar a .env.local (no se versiona) y completar. Ninguna de estas variables llega al navegador.

# Dirección de la API de Spring, sin /api/v1.
API_BASE_URL=http://localhost:8080
# Cuánto se espera a la API antes de darla por caída, en milisegundos (por defecto 30000).
#API_TIMEOUT_MS=30000
# Dirección pública de esta aplicación web. Debe coincidir con EINVOICE_WEB_URL de la API: a ella
# llevan los enlaces de los correos (confirmar el correo, cambiar la contraseña).
APP_BASE_URL=http://localhost:3000

# Secreto con el que se cifran las cookies de sesión: al menos 32 caracteres aleatorios.
# Para generarlo: openssl rand -base64 48
SESSION_SECRET=change-me

# Proxies de confianza que añaden su entrada a X-Forwarded-For: la IP del navegador es la que queda
# en esa posición contando desde la derecha (por defecto 1). En Cloud Run, 2 con un balanceador
# HTTPS delante de la web.
#TRUSTED_PROXY_HOPS=1

# Desactiva la telemetría anónima de Next.js.
NEXT_TELEMETRY_DISABLED=1
